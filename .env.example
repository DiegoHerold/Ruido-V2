# CONFIGURAÇÃO LOCAL — copie este arquivo para .env
# O arquivo .env contém segredo e já está no .gitignore. Nunca o envie por e-mail ou commit.

# === PASTAS DA OPERAÇÃO ===
# Sem --input, a automação lê todas as planilhas .xlsx/.xls/.csv desta pasta, em ordem alfabética.
# Após terminar uma planilha, fecha todas as sessões do Chrome antes de iniciar a próxima.
INPUT_FOLDER=F:/TI/PowerAutomate/Consulta SST/Planilha Base

# Cada planilha processada recebe uma subpasta própria com report.xlsx, report.csv e report.md.
RESULTS_FOLDER=F:/TI/PowerAutomate/Consulta SST/Resultados

# Titular usado para validar o contexto inicial após o certificado.
ESOCIAL_COMPANY=BIASON CONTABILIDADE
# Opcional: CNPJ do titular, somente se a tela inicial exigir essa validação.
ESOCIAL_COMPANY_CNPJ=

# === CHROME ===
# O Chrome atual bloqueia automacao no perfil real do usuario.
# A automacao nao força maximizar a janela, para evitar conflito com Redtrust/janelas nativas.
# false: mantem o perfil .chrome-automation-profile persistente, preservando Redtrust.
# true: recria o perfil a cada execucao; use so para resetar, pois apaga ajustes/extensoes locais.
CHROME_PROFILE_REFRESH=false

# true: fecha todas as sessoes do Chrome e abre um perfil dedicado da automacao com porta de controle.
# Voce faz login com Redtrust/CAPTCHA nessa mesma janela; na primeira vez,
# instale/configure a Redtrust nesse perfil se ela nao aparecer.
# Ao pressionar ENTER,
# a automacao continua nessa mesma sessao, sem fechar/reabrir e sem copiar perfil.
# false: tenta seguir sem pausa manual; deixe false somente para testes internos.
MANUAL_LOGIN_BEFORE_RUN=true
# Porta local usada para o robo controlar o Chrome depois do seu ENTER.
CHROME_REMOTE_DEBUGGING_PORT=9222
# Perfil dedicado que permite a porta de controle. Foi o caminho que funcionou no teste manual.
CHROME_DEBUG_USER_DATA_DIR=C:/tmp/chrome-debug-esocial

# true: antes de abrir o Chrome, apaga cookies/sessao/abas antigas do perfil de automacao.
# Isso evita cair na tela "Sua sessao no sistema foi encerrada..." e força login novo.
# Preserva extensoes/configuracoes do perfil, incluindo Redtrust se ela estiver instalada nele.
CLEAR_ESOCIAL_SESSION_BEFORE_LOGIN=true

# URL inicial do login manual. Use login.aspx para sempre abrir direto na tela de login.
ESOCIAL_MANUAL_LOGIN_START_URL=https://login.esocial.gov.br/login.aspx

# Nome antigo mantido por compatibilidade. Ignorado quando MANUAL_LOGIN_BEFORE_RUN estiver definido.
REAL_USER_LOGIN_BOOTSTRAP=false

# Se a extensao do certificado (ex.: Redtrust) nao vier no perfil espelhado,
# informe aqui a pasta da versao da extensao que contem manifest.json.
# Para mais de uma extensao, separe por ponto e virgula.
# Exemplo:
# CHROME_EXTENSION_PATHS=C:/Users/diego/AppData/Local/Google/Chrome/User Data/Profile 1/Extensions/ID_DA_EXTENSAO/1.0.0
CHROME_EXTENSION_PATHS=

# === IA PARA DIAGNÓSTICO (opcional; não participa do login) ===
# O login eSocial é totalmente determinístico: DOM + OCR local do certificado.
# false: a automação usa apenas recuperação determinística e não consome API.
# true: permite UMA chamada de diagnóstico somente após uma falha sem recuperação segura.
AI_DIAGNOSIS_ENABLED=false

# Use openai_responses para a API oficial da OpenAI.
# Use diagnostic_proxy somente se sua empresa tiver um endpoint próprio que devolva o JSON de diagnóstico.
AI_DIAGNOSIS_PROVIDER=openai_responses

# Endpoint oficial. Não altere para OpenAI; troque apenas se usar proxy interno.
AI_DIAGNOSIS_ENDPOINT=https://api.openai.com/v1/responses

# Chave enviada como Authorization: Bearer <chave>. Nunca coloque a chave no código.
AI_DIAGNOSIS_API_KEY=

# MODELO RECOMENDADO: econômico e suficiente para classificar falhas e retornar JSON.
# Preço de referência: US$ 0,20 / 1 milhão de tokens de entrada e US$ 1,20 / 1 milhão de saída.
# Alternativa mais capaz e mais cara: gpt-5.6-terra (US$ 2,00 entrada; US$ 12,00 saída / 1M).
AI_DIAGNOSIS_MODEL=gpt-5.6-luna

# === LIMITES DE CONSUMO POR EXECUÇÃO ===
# A automação bloqueia novas chamadas antes de exceder estes limites.
MAX_AI_CALLS_PER_RUN=3
# Para um diagnóstico curto, 6.000 tokens de entrada + 600 de saída custam cerca de US$ 0,0019 com o modelo recomendado.
MAX_AI_INPUT_TOKENS_PER_RUN=6000
MAX_AI_OUTPUT_TOKENS_PER_RUN=600
# Limite rígido por execução. Se a resposta ultrapassar este valor, o gasto é registrado e novas chamadas são bloqueadas.
MAX_AI_COST_USD_PER_RUN=0.01

# Preços opcionais em USD por 1 milhão de tokens.
# Use 0 se o endpoint já retornar "cost_usd" na resposta.
AI_INPUT_COST_USD_PER_1M=0.20
AI_OUTPUT_COST_USD_PER_1M=1.20

# === OCR DO CERTIFICADO DIGITAL ===
# Apos clicar em "Seu certificado digital", se houver CAPTCHA/intervencao manual,
# resolva no navegador e pressione ENTER no terminal quando o seletor de certificado aparecer.
# Deixe em branco se o tesseract.exe estiver no PATH do Windows.
# Exemplo: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=
# Para o seletor de certificado, eng costuma ser suficiente para BIASON CONTABILIDADE.
# Use por somente se o pacote portugues estiver instalado no tessdata.
OCR_LANG=eng
